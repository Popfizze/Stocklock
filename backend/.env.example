# StockLock backend configuration. Copy to backend/.env (never commit .env).
# AWS credentials come from the default profile in ~/.aws, not from this file.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
BEDROCK_FAST_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# local = agents run in-process; agentcore = narration via the AgentCore Runtime below
AGENT_MODE=local
AGENTCORE_RUNTIME_ARN=
# SEC asks for a descriptive User-Agent with a contact address
SEC_USER_AGENT=StockLock datathon research contact@example.com
CORS_ORIGINS=http://localhost:5173
# Relative paths are resolved from backend/
DATA_DIR=../alphaforge_starter
CACHE_DIR=.cache
