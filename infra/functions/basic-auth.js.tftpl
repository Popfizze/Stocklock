// CloudFront Function (cloudfront-js-2.0, viewer-request): HTTP Basic Auth gate for the whole site.
// Terraform renders this template with the expected base64("user:password"); it is never committed.
const EXPECTED = 'Basic ${auth_b64}';

function handler(event) {
  const request = event.request;
  const authorization = request.headers.authorization;

  if (authorization && authorization.value === EXPECTED) {
    return request;
  }

  return {
    statusCode: 401,
    statusDescription: 'Unauthorized',
    headers: {
      'www-authenticate': { value: 'Basic realm="StockLock", charset="UTF-8"' },
    },
  };
}
