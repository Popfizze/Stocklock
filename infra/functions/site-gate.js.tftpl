// CloudFront Function (cloudfront-js-2.0, viewer-request): demo access gate for the whole site.
// A non-empty access cookie means the visitor has completed the demo password prompt; all passwords work.
// Terraform renders the self-contained login page into this function.
const LOGIN_PAGE = ${login_page};

function handler(event) {
  const request = event.request;
  const cookie = request.cookies.stocklock_access;

  if (cookie && cookie.value) {
    return request;
  }

  return {
    statusCode: 200,
    statusDescription: 'OK',
    headers: {
      'content-type': { value: 'text/html; charset=utf-8' },
      'cache-control': { value: 'no-store' },
    },
    body: {
      encoding: 'text',
      data: LOGIN_PAGE,
    },
  };
}
