// CloudFront Function (cloudfront-js-2.0, viewer-request): password gate for the whole site.
// A request whose stocklock_access cookie holds the SHA-256 (hex) of the password goes through
// unchanged; any other request gets the self-contained login page, which sets that cookie.
// Terraform renders this template with the expected hash (never committed) and login.html.
const EXPECTED_HASH = '${password_sha256}';
const LOGIN_PAGE = ${login_page};
const ERROR_SLOT = '<!--error-->';
const ERROR_HTML = '<p class="error" role="alert">Mot de passe incorrect.</p>';

function handler(event) {
  const request = event.request;
  const cookie = request.cookies.stocklock_access;

  if (cookie && cookie.value === EXPECTED_HASH) {
    return request;
  }

  return {
    statusCode: 200,
    statusDescription: 'OK',
    headers: {
      'content-type': { value: 'text/html; charset=utf-8' },
      'cache-control': { value: 'no-store' },
    },
    body: {
      encoding: 'text',
      data: LOGIN_PAGE.replace(ERROR_SLOT, cookie ? ERROR_HTML : ''),
    },
  };
}
