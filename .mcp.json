{
  "mcpServers": {
    "aws-docs": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    },
    "strands": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "strands-agents-mcp-server"
      ],
      "env": {}
    }
  }
}